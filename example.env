# Main database
POSTGRES_USER=ygouser
POSTGRES_PASSWORD=ygopassword
POSTGRES_DB=ygodb

# Auth database
AUTH_POSTGRES_USER=authuser
AUTH_POSTGRES_PASSWORD=authpassword
AUTH_POSTGRES_DB=authdb

# API database connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=ygouser
DB_PASSWORD=ygopassword
DB_NAME=ygodb
DB_SSLMODE=disable

# Gin
GIN_MODE=release

# Svelte (svelte/.env)
DATABASE_URL=postgres://authuser:authpassword@localhost:5433/authdb
PUBLIC_API_URL=https://localhost:8443/ygomp-api
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:5173
